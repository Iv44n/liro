# Loaded automatically by `bun test` (overrides .env)
ENVIRONMENT=test
PORT=0
APP_URL=http://localhost:3003
AUTH_URL=http://localhost:3002
AUTH_SECRET=test-secret-test-secret-test-secret-00
DATABASE_URL=postgresql://liro_user:liro_password@localhost:5434/liro_test
EMAIL_PROVIDER=memory
EMAIL_FROM=Liro Test <test@liro.local>
EVALUATOR_PROVIDER=fake
RUN_WORKER=false
ENCRYPTION_KEY=test-encryption-key-not-for-production-00
# So webhook receivers on 127.0.0.1 (local Bun.serve in tests) can be reached.
# outbound.test.ts passes allowPrivate: false explicitly for its SSRF cases.
WEBHOOK_ALLOW_PRIVATE=true
