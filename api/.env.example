PORT=3002
APP_URL=http://localhost:3003
AUTH_SECRET=
AUTH_URL=http://localhost:3002
DATABASE_URL=postgresql://liro_user:liro_password@localhost:5434/liro_db
RESEND_API_KEY=
EMAIL_FROM=Liro <onboarding@resend.dev>
# resend | console (logs emails, dev) | memory (tests)
EMAIL_PROVIDER=resend
# vercel-gateway | typesafe | fake
EVALUATOR_PROVIDER=vercel-gateway
# Optional: vercel-gateway | typesafe (not the primary, not with fake; needs its
# key). Tried once when the primary is unavailable, overloaded or rate limited;
# never for versions pinned to a model the fallback can't pin (the gateway).
EVALUATOR_FALLBACK_PROVIDER=
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
# typesafe only: pins e.g. 1.13.0 (jev-1.13.0) for versions that don't pin one;
# empty uses the moving jev-latest alias
JEV_MODEL_VERSION=
# Any string; hashed with SHA-256 into the AES-256 key used to encrypt
# secrets at rest (webhook secrets, Slack webhook URLs). Generate one with
# `openssl rand -hex 32`. Required before any effect/webhook feature is used.
ENCRYPTION_KEY=
# Optional: the outgoing key while rotating ENCRYPTION_KEY (decrypt-only).
# To rotate, move the current ENCRYPTION_KEY value here, then set a new
# ENCRYPTION_KEY. Values written before the rotation keep decrypting
# automatically (decryptSecret tries both keys) — no data migration needed.
# Safe to unset again once nothing still needs the old key.
ENCRYPTION_KEY_PREVIOUS=
RUN_WORKER=false
# Dev only: allows http:// and private/loopback/link-local addresses for
# webhook and Slack effect URLs, so local receivers can be tested.
WEBHOOK_ALLOW_PRIVATE=false
